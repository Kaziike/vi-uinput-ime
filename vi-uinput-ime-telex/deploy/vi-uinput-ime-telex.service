# /etc/systemd/system/vi-uinput-ime-telex.service
# Systemd daemon unit running vi-uinput-ime-telex under isolated system user `vi-ime`.

[Unit]
Description=Low-Latency Linux Vietnamese Telex IME (evdev/uinput + Custom XKB + Strict FIFO)
After=systemd-udevd.service local-fs.target
Wants=systemd-udevd.service
Conflicts=vi-uinput-ime-vni.service

[Service]
Type=simple
User=vi-ime
Group=vi-ime
SupplementaryGroups=input
ExecStartPre=+-/usr/bin/modprobe -q uinput
ExecStartPre=+-/usr/bin/udevadm settle --timeout=5
ExecStartPre=+-/usr/bin/setfacl -m g::rw,g:vi-ime:rw,m::rw /dev/uinput
ExecStart=/usr/local/bin/vi-uinput-ime-telex --config /etc/vi-uinput-ime-telex/config.toml
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
KillSignal=SIGTERM

# Runtime directory for Waybar/Polybar state indicator (/run/vi-uinput-ime-telex/state)
# and compositor IPC bridge UNIX socket (/run/vi-uinput-ime-telex/ipc.sock)
RuntimeDirectory=vi-uinput-ime-telex
RuntimeDirectoryMode=0755

# Security Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=-/dev/uinput /dev/input /run/vi-uinput-ime-telex

# Compositor IPC Bridge: enable companion user unit `vi-uinput-ime-telex-ipc.service`
# (`systemctl --user enable --now vi-uinput-ime-telex-ipc.service`) to forward
# Hyprland/Sway/X11 window focus & workspace events to /run/vi-uinput-ime-telex/ipc.sock.
EnvironmentFile=-/run/vi-uinput-ime-telex/session.env

[Install]
WantedBy=multi-user.target
